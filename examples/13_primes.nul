// ------------------------------------------------------------------
// 13_primes.nul — a more complete program: sieve of Eratosthenes.
//
// Computes the primes up to 30 with a bit-flag sieve. Since there are
// no arrays, the sieve is a struct of u8 "cells" (0 = still prime,
// 1 = marked composite), read/written through an index-resolving
// helper (each call folds to a constant field access).
//
// Features on show: structs, globals, many small functions, for loops
// with nested/arithmetic bounds, if/elif/else, u8 casts, pointer
// derefs, and helpers composed out of each other.
// ------------------------------------------------------------------

// One cell per candidate 0..29; cell[i] == 0 means "prime so far".
struct Sieve
{
    c2 : u8,  c3 : u8,  c4 : u8,  c5 : u8,  c6 : u8,  c7 : u8,  c8 : u8,  c9 : u8,
    c10 : u8, c11 : u8, c12 : u8, c13 : u8, c14 : u8, c15 : u8, c16 : u8, c17 : u8,
    c18 : u8, c19 : u8, c20 : u8, c21 : u8, c22 : u8, c23 : u8, c24 : u8, c25 : u8,
    c26 : u8, c27 : u8, c28 : u8, c29 : u8,
}

// Global sieve, built once.
g_sieve := Sieve { 0 }

fn cell_at(i : i64) -> u8
{
    if i == 2 { return g_sieve.c2; }
    elif i == 3 { return g_sieve.c3; }
    elif i == 4 { return g_sieve.c4; }
    elif i == 5 { return g_sieve.c5; }
    elif i == 6 { return g_sieve.c6; }
    elif i == 7 { return g_sieve.c7; }
    elif i == 8 { return g_sieve.c8; }
    elif i == 9 { return g_sieve.c9; }
    elif i == 10 { return g_sieve.c10; }
    elif i == 11 { return g_sieve.c11; }
    elif i == 12 { return g_sieve.c12; }
    elif i == 13 { return g_sieve.c13; }
    elif i == 14 { return g_sieve.c14; }
    elif i == 15 { return g_sieve.c15; }
    elif i == 16 { return g_sieve.c16; }
    elif i == 17 { return g_sieve.c17; }
    elif i == 18 { return g_sieve.c18; }
    elif i == 19 { return g_sieve.c19; }
    elif i == 20 { return g_sieve.c20; }
    elif i == 21 { return g_sieve.c21; }
    elif i == 22 { return g_sieve.c22; }
    elif i == 23 { return g_sieve.c23; }
    elif i == 24 { return g_sieve.c24; }
    elif i == 25 { return g_sieve.c25; }
    elif i == 26 { return g_sieve.c26; }
    elif i == 27 { return g_sieve.c27; }
    elif i == 28 { return g_sieve.c28; }
    elif i == 29 { return g_sieve.c29; }
    return 1;
}

fn mark(i : i64)
{
    if i == 2 { g_sieve.c2 = 1; }
    elif i == 3 { g_sieve.c3 = 1; }
    elif i == 4 { g_sieve.c4 = 1; }
    elif i == 5 { g_sieve.c5 = 1; }
    elif i == 6 { g_sieve.c6 = 1; }
    elif i == 7 { g_sieve.c7 = 1; }
    elif i == 8 { g_sieve.c8 = 1; }
    elif i == 9 { g_sieve.c9 = 1; }
    elif i == 10 { g_sieve.c10 = 1; }
    elif i == 11 { g_sieve.c11 = 1; }
    elif i == 12 { g_sieve.c12 = 1; }
    elif i == 13 { g_sieve.c13 = 1; }
    elif i == 14 { g_sieve.c14 = 1; }
    elif i == 15 { g_sieve.c15 = 1; }
    elif i == 16 { g_sieve.c16 = 1; }
    elif i == 17 { g_sieve.c17 = 1; }
    elif i == 18 { g_sieve.c18 = 1; }
    elif i == 19 { g_sieve.c19 = 1; }
    elif i == 20 { g_sieve.c20 = 1; }
    elif i == 21 { g_sieve.c21 = 1; }
    elif i == 22 { g_sieve.c22 = 1; }
    elif i == 23 { g_sieve.c23 = 1; }
    elif i == 24 { g_sieve.c24 = 1; }
    elif i == 25 { g_sieve.c25 = 1; }
    elif i == 26 { g_sieve.c26 = 1; }
    elif i == 27 { g_sieve.c27 = 1; }
    elif i == 28 { g_sieve.c28 = 1; }
    elif i == 29 { g_sieve.c29 = 1; }
}

fn run_sieve()
{
    // Start at p = 2 and mark every multiple p*p, p*p+p, ...
    for p := 2 .. 30 {
        if cell_at(p) == 0 {
            // Mark all multiples of p (from p*p) as composite.
            for m := p * p .. 30 {
                if m % p == 0 {
                    mark(m);
                }
            }
        }
    }
}

fn is_prime(n : i64) -> bool
{
    if n < 2 {
        return false;
    }
    return cell_at(n) == 0;
}

fn main()
{
    // 0 and 1 are not prime.
    mark(0);
    mark(1);

    run_sieve();

    // Print the primes up to 29.
    print("primes up to 29: ");
    count := 0;
    for i := 0 .. 30 {
        if is_prime(i) {
            print(i);
            count = count + 1;
        }
    }
    print("count: ");
    print(count);
    print("\n");

    // A few direct checks.
    print(is_prime(7));
    print(is_prime(8));
    print(is_prime(13));
    print(is_prime(25));

    // 2 is the only even prime.
    print(is_prime(2));
    print(is_prime(4));
}
