// ------------------------------------------------------------------
// 07_globals.nul — Global variables shared across functions.
//
// Declared at the top level of a file, `g_name := value` (inferred)
// or `g_name : T = value` (explicit). Globals are readable/writable
// from every function and persist for the program's lifetime.
// Initializers run before main.
// ------------------------------------------------------------------

g_counter : i64 = 0
g_message := "global"
g_limit : i64 = 5
g_uninit : i64 = 0

fn bump()
{
    g_counter = g_counter + 1;
}

fn reset()
{
    g_counter = 0;
}

fn double_global()
{
    g_counter = g_counter * 2;
}

fn main()
{
    // Read a global.
    print(g_message);
    print(g_limit);

    // Uninitialized globals default to zero.
    print(g_uninit);

    // Mutate from main and from functions.
    g_uninit = 10;
    bump();
    bump();
    print(g_counter);     // 2

    double_global();
    print(g_counter);     // 4

    reset();
    print(g_counter);     // 0

    // Globals work in conditions and loops.
    if g_limit > 0 {
        g_counter = g_counter + 1;
    }
    print(g_counter);     // 1

    // A global can back a loop bound read inside the body.
    g_counter = 0;
    for i := 0 .. g_limit {
        print(i);
    }
    print("---\n");

    // Global structs are fine too.
    // (Declared inline: no top-level struct in this file, so skip.)

    // Global as shared counter used by a helper.
    total := 0;
    for i := 0 .. 3 {
        bump();
        total = total + g_counter;
    }
    print(total);   // 1 + 2 + 3 = 6
}
